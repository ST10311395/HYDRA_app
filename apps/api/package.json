{
  "name": "@hydra/api",
  "version": "1.0.0",
  "private": true,
  "description": "HYDRA REST API (Node.js + Express + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts seeds",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "tsx --env-file-if-exists=.env scripts/embedded-db.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env seeds/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/migrate.ts --reset && tsx --env-file-if-exists=.env seeds/seed.ts",
    "jobs": "tsx --env-file-if-exists=.env src/jobs/worker.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "owner:create": "tsx --env-file-if-exists=.env src/db/createOwner.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@azure/storage-blob": "^12.34.0",
    "@hydra/shared": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "expo-server-sdk": "^7.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.12",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
