# =============================================================================
# HYDRA environment variables. Copy to apps/api/.env (API) and apps/mobile/.env (mobile).
# NEVER commit real values. Production values live in Azure Key Vault / App Service settings.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development              # development | test | production
APP_ENV=local                     # local | staging | production
HOST=0.0.0.0                      # bind all interfaces so phones on the LAN can reach a local API
PORT=4000
LOG_LEVEL=info                    # fatal | error | warn | info | debug | trace
# Externally reachable base URL (signed file links, sandbox checkout). For phone testing use the LAN IP —
# `npm run lan` sets it (and EXPO_PUBLIC_API_URL) automatically.
PUBLIC_API_BASE_URL=http://localhost:4000
# Production: exact allowlist. Development also accepts localhost/127.0.0.1 and private-LAN origins.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=false                 # true behind Azure App Service / Front Door

# ---- Database ----------------------------------------------------------------
# Local embedded/docker PostgreSQL uses port 5433. Production: Azure Database for PostgreSQL (sslmode=require).
DATABASE_URL=postgres://hydra:hydra_local_dev@localhost:5433/hydra
DATABASE_SSL=false                # true in staging/production
DATABASE_POOL_MAX=10

# ---- Auth / JWT --------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=hydra-api
JWT_AUDIENCE=hydra-mobile
QR_TOKEN_TTL_MINUTES=15
BCRYPT_COST=12

# ---- Google Sign-In (OAuth 2.0 / OpenID Connect) -----------------------------
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ---- File storage --------------------------------------------------------------
STORAGE_PROVIDER=local            # local | azure
LOCAL_UPLOAD_DIR=./uploads
FILE_URL_SIGNING_SECRET=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=hydra-private
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Payments ------------------------------------------------------------------
PAYMENT_PROVIDER=simulated        # paystack | simulated (simulated is refused when NODE_ENV=production)
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=           # simulated gateway HMAC secret (Paystack signs with PAYMENT_SECRET_KEY)
PAYMENT_CALLBACK_URL=hydra://payments/complete
PAYMENT_CURRENCY=ZAR

# ---- Messaging (missed-call automated responses) -------------------------------
SMS_PROVIDER=none                 # twilio | none
SMS_API_KEY=                      # Twilio: ACCOUNT_SID:AUTH_TOKEN
SMS_FROM_NUMBER=
WHATSAPP_PROVIDER=none            # twilio | none
WHATSAPP_API_KEY=                 # Twilio: ACCOUNT_SID:AUTH_TOKEN
WHATSAPP_FROM_NUMBER=

# ---- Push / Email ----------------------------------------------------------------
PUSH_NOTIFICATION_CONFIG=expo     # expo | none
EXPO_ACCESS_TOKEN=
EMAIL_PROVIDER=console            # smtp | console (console refused in production)
EMAIL_API_KEY=                    # SMTP URL, e.g. smtps://user:pass@smtp.example.com:465
EMAIL_FROM="PSG Electrical <no-reply@example.co.za>"
PASSWORD_RESET_URL=hydra://reset-password

# ---- Seed (development only) -------------------------------------------------------
# Demo account password used by `npm run db:seed`. If blank, a random password is generated and printed once.
SEED_DEMO_PASSWORD=

# ---- Mobile (Expo — must be prefixed EXPO_PUBLIC_, never put secrets here) -----------
# Physical phone: http://<your PC's LAN IP>:4000 (run `npm run lan`). Never localhost/10.0.2.2 on a phone —
# in development the app rewrites those to the Metro host's LAN IP. Leave blank to auto-detect from Metro.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_EAS_PROJECT_ID=
